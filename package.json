{
  "name": "devstudio-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run lint:css",
    "db:push": "supabase db push --include-seed",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "payment:simulate": "node scripts/simulate-payment.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/react": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.57.0",
    "ai": "^5.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.0",
    "stylelint": "^16.0.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-standard": "^38.0.0",
    "supabase": "^2.40.0",
    "typescript": "^5.0.0"
  }
}
