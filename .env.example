# Copy to .env.local and fill in. Never commit real values.

# Supabase: All three are used server-side only; the browser never talks to Supabase.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
SUPABASE_DB_URL=YOUR_STRING_URL

# Gemini https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: defaults to gemini-3.6-flash
GOOGLE_ADVISOR_MODEL=

# Stripe — https://dashboard.stripe.com/test/apikeys (use test keys first)
STRIPE_SECRET_KEY=YOUR_KEY
# Printed by `stripe listen`, or copied from the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=YOUR_KEY

# Admin panel at /admin (minimum 8 characters; leave empty to disable it)
ADMIN_PASSWORD=

# Optional: absolute site URL used for Stripe return links.
# Leave empty locally; required behind a proxy that rewrites the host.
SITE_URL=YOUR_KEY
I_API_KEY=YOUR_KEY